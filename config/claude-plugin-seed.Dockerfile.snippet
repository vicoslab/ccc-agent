# Optional Dockerfile snippet: materialize the bundled CCC Claude plugin seed.
#
# `ccc-agent setup --system` now performs this automatically. This standalone
# command is useful when an image build wants to create the seed in a separate
# layer before runtime configuration is generated.

# Install ccc-agent before this snippet:
# RUN pip install --break-system-packages ccc-agent

RUN python -m ccc_agent.claude_plugin --seed-dir /opt/claude-seed

# ccc-agent setup writes only enabledPlugins for ccc@ccc-agent. It does not add
# settings-level hooks or an extra marketplace source.
ENV CLAUDE_CODE_PLUGIN_SEED_DIR=/opt/claude-seed
