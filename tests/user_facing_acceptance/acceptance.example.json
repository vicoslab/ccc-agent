{
  "ccc_agent": "/usr/local/bin/ccc-agent",
  "ccc_agent_config": "/etc/ccc-agent/config.json",
  "test_root": "/storage/user/ccc-agent-acceptance",
  "artifacts_dir": "/var/tmp/ccc-agent-acceptance-results",
  "timeout_seconds": 1200,
  "poll_seconds": 0.5,
  "agents": {
    "codex": {
      "transports": {
        "local-cli": {
          "driver": "tmux",
          "command": [
            "{ccc_agent}",
            "run",
            "--config",
            "{ccc_agent_config}",
            "--workspace",
            "{workspace}",
            "--agent",
            "codex",
            "--",
            "/home/domen/conda/envs/codex/bin/codex",
            "--dangerously-bypass-approvals-and-sandbox"
          ],
          "expected_agent_kind": "codex",
          "final_review_action": "abort",
          "startup_seconds": 8,
          "exit_text": "/exit",
          "user_flow": "direct-cli"
        },
        "ssh-cli": {
          "driver": "tmux",
          "command": [
            "ssh",
            "-tt",
            "REPLACE_WITH_SSH_TARGET",
            "cd {workspace_shell} && /home/domen/conda/envs/codex/bin/codex --dangerously-bypass-approvals-and-sandbox"
          ],
          "expected_agent_kind": "codex-remote",
          "startup_seconds": 10,
          "exit_text": "/exit",
          "user_flow": "direct-cli"
        },
        "remote-server": {
          "driver": "external",
          "command": [
            "python",
            "scripts/manual-observed-client-driver.py",
            "{scenario_file}"
          ],
          "expected_agent_kind": "codex-remote",
          "user_flow": "observed-client",
          "evidence": {
            "basis": "direct-observation",
            "client_product": "Codex Desktop",
            "client_version": "REPLACE_WITH_OBSERVED_CLIENT_VERSION",
            "observed_at": "REPLACE_WITH_OBSERVATION_TIMESTAMP",
            "artifact": "REPLACE_WITH_SCREENSHOT_OR_CAPTURE_PATH"
          },
          "operator_instructions": [
            "Open Codex Desktop; do not launch a substitute CLI or server command.",
            "Use the product UI to connect to REPLACE_WITH_SSH_TARGET through the configured CCC SSH router.",
            "Open {workspace} in that remote client and capture a screenshot showing product, target, and workspace.",
            "Paste each prompt printed by the manual driver exactly and return to its terminal when requested."
          ]
        }
      },
      "client_executable": "/home/domen/conda/envs/codex/bin/codex"
    },
