{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/ccc-workspace-hook.sh",
            "statusMessage": "Registering CCC workspace"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/ccc-workspace-hook.sh",
            "statusMessage": "Registering CCC subagent workspace"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/ccc-workspace-hook.sh",
            "statusMessage": "Releasing CCC subagent workspace"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/ccc-stop-hook.sh"
          }
        ]
      }
    ]
  }
}
